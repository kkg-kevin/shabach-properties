# Supabase project URL (Project Settings -> API), e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase service role / secret key (Project Settings -> API keys).
# Keep this private: it gives full access to the database.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin dashboard (use a long, unique one)
ADMIN_PASSWORD=

# Optional: email the team when a new enquiry arrives (free account at resend.com)
# RESEND_API_KEY=
# LEAD_NOTIFY_EMAIL=you@example.com
# LEAD_NOTIFY_FROM=Shabach Properties <leads@yourdomain.co.ke>
